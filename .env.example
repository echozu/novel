# ===== LLM keys =====
# DeepSeek (OpenAI-compatible) — 用于 Layer1 大批量 Map
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude — 用于 Layer2/3 Reduce + 反思
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# 阿里云百炼（OpenAI 兼容 embedding，可选）
DASHSCOPE_API_KEY=
DASHSCOPE_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 也可以走 OpenAI 兼容代理（可选）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ===== Neo4j =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=novel-lab-pass

# ===== Embeddings =====
# 本地（默认）：EMBEDDING_BACKEND 留空 + 无 DASHSCOPE_API_KEY 时用 HuggingFace
# 阿里云百炼：设置 DASHSCOPE_API_KEY 后会自动走 dashscope（也可显式 EMBEDDING_BACKEND=dashscope）
EMBEDDING_BACKEND=
# 百炼兼容模型名（与本地 HF 模型名区分）
EMBEDDING_DS_MODEL=text-embedding-v3
# 本地 sentence-transformers 模型（仅 EMBEDDING_BACKEND=local 或未配置百炼时）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=16
DASHSCOPE_EMBED_TIMEOUT=180
DASHSCOPE_EMBED_CONNECT_TIMEOUT=15
# 单条 embedding 输入过长时截断字符数，避免服务端断开连接
DASHSCOPE_EMBED_MAX_CHARS=6000
# 跳过 Chroma 向量索引（仅保留章节原文给 Critic；不调用 DashScope embedding）
NOVEL_LAB_SKIP_INDEX=0
# 切换 embedding 后端后需强制重建向量库：1 会删除旧 chroma 集合并重算
NOVEL_LAB_FORCE_REINDEX=0

# ===== HTTP 超时（秒）=====
OPENAI_HTTP_READ_TIMEOUT=360
OPENAI_HTTP_CONNECT_TIMEOUT=30
# 单章 Map 分析最长等待（秒），超时记为失败章，避免整书卡死
MAP_CHAPTER_TIMEOUT_SEC=420

# ===== Runtime =====
NOVEL_LAB_WORKDIR=./.workdir
NOVEL_LAB_TIER=balanced       # basic | balanced | premium | local
NOVEL_LAB_MAP_CONCURRENCY=20
NOVEL_LAB_REDUCE_CONCURRENCY=4
